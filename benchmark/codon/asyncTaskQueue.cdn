NB. export
class. AsyncTaskQueue do.
queue =: (0$0)
activeCount =: 0
constructor. concurrency do.
(this.concurrency = concurrency)
end.
method. add task do.
return. (new Promise {{resolve,reject => do.
run =: {{async => do.
(this.activeCount++)
try. do.
(resolve (@ task()))
catch. err do.
(reject err)
finally. do.
(this.activeCount--)
next =: this.queue.shift()
if. next do.
next()
end.
end.
}}
if. (this.activeCount < this.concurrency) do.
run()
else.
(this.queue.push run)
end.
}})
end.
get. pending do.
return. this.queue.length
end.
end.

queue =: (new AsyncTaskQueue 2)

delay =: {{ms => (new Promise {{resolve => (setTimeout resolve ms)}})}}

tasks =: ((1;2;3;4).map {{id => (queue.add {{async => do.
@ (delay 50)
return. `Task ${id} done`
}})}})

((Promise.all tasks).then console.log)