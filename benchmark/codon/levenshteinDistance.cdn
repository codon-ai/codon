export. fn. levenshteinDistance a,b do.
if. (a === b) do.
return. 0
end.
if. (a.length === 0) do.
return. b.length
end.
if. (b.length === 0) do.
return. a.length
end.
dp =: (Array.from O(length:(a.length + 1)) {{ => ((new Array (b.length + 1)).fill 0)}})
for. i =: 0 ; (i <= a.length) ; (i++) do.
(dp.[i].[0] = i)
end.
for. j =: 0 ; (j <= b.length) ; (j++) do.
(dp.[0].[j] = j)
end.
for. i =: 1 ; (i <= a.length) ; (i++) do.
for. j =: 1 ; (j <= b.length) ; (j++) do.
cost =: ((a.[(i - 1)] === b.[(j - 1)]) ? 0 : 1)
(dp.[i].[j] = (Math.min (dp.[(i - 1)].[j] + 1) (dp.[i].[(j - 1)] + 1) (dp.[(i - 1)].[(j - 1)] + cost)))
end.
end.
return. dp.[a.length].[b.length]
end.