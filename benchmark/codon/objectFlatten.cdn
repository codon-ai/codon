export. fn. flattenObject obj,prefix='' do.
result =: O''
for_of. k : (Object.keys obj) do.
keyName =: (prefix ? `${prefix}.${k}` : k)
val =: obj.[k]
if. (((((val !== '') && ((typeof val) === 'object')) && (! (Array.isArray val))) && (! (val instanceof Date))) && ((Object.keys val).length > 0)) do.
(Object.assign result (flattenObject val keyName))
else.
(result.[keyName] = val)
end.
end.
return. result
end.