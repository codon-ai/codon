import. crypto from 'node:crypto'

fn. base64url str do.
buf =: ((Buffer.isBuffer str) ? str : (Buffer.from str))
return. (buf.toString 'base64url')
end.

export. fn. signJwt payload,secret do.
encodedHeader =: (base64url (JSON.stringify O(alg:'HS256';typ:'JWT')))
encodedPayload =: (base64url (JSON.stringify payload))
data =: `${encodedHeader}.${encodedPayload}`
signature =: (((crypto.createHmac 'sha256' secret).update data).digest 'base64url')
return. `${data}.${signature}`
end.

export. fn. verifyJwt token,secret do.
parts =: (token.split '.')
if. (parts.length !== 3) do.
return. ''
end.
data =: `${parts.[0]}.${parts.[1]}`
expectedSig =: (((crypto.createHmac 'sha256' secret).update data).digest 'base64url')
sigBuf =: (Buffer.from parts.[2])
expBuf =: (Buffer.from expectedSig)
if. ((sigBuf.length !== expBuf.length) || (! (crypto.timingSafeEqual sigBuf expBuf))) do.
return. ''
end.
try. do.
payloadStr =: ((Buffer.from parts.[1] 'base64url').toString 'utf8')
return. (JSON.parse payloadStr)
catch. err do.
return. ''
end.
end.