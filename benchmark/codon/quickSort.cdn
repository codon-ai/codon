export. fn. quickSort arr,compare,left,right do.
if. (compare === undefined) do.
(compare = {{a,b => ((a < b) ? (- 1) : ((a > b) ? 1 : 0))}})
end.
if. (left === undefined) do.
(left = 0)
end.
if. (right === undefined) do.
(right = (arr.length - 1))
end.
if. (left < right) do.
pivot =: arr.[right]
i =: left
for. j =: left ; (j < right) ; (j++) do.
if. ((compare arr.[j] pivot) < 0) do.
tmp =: arr.[i]
(arr.[i] = arr.[j])
(arr.[j] = tmp)
(i++)
end.
end.
tmp =: arr.[i]
(arr.[i] = arr.[right])
(arr.[right] = tmp)
(quickSort arr compare left (i - 1))
(quickSort arr compare (i + 1) right)
end.
return. arr
end.