import. fs from 'node:fs/promises'

import. os from 'node:os'

import. path from 'node:path'

export. class. TempFileManager do.
constructor.  do.
(this.trackedPaths = (0$0))
end.
async_method. createTempFile prefix,content do.
filename =: `${prefix}-${Date.now()}-${(((Math.random()).toString 36).slice 2)}.tmp`
filePath =: (path.join os.tmpdir() filename)
@ (fs.writeFile filePath content 'utf8')
(this.trackedPaths.push filePath)
return. filePath
end.
async_method. createTempDir prefix do.
dirPath =: @ (fs.mkdtemp (path.join os.tmpdir() `${prefix}-`))
(this.trackedPaths.push dirPath)
return. dirPath
end.
async_method. cleanup  do.
count =: 0
for_of. p : this.trackedPaths do.
@ (fs.rm p O(recursive:true;force:true))
(count++)
end.
(this.trackedPaths = (0$0))
return. count
end.
end.