export. class. HttpError extends Error do.
constructor. statusCode,message do.
(super message)
(this.statusCode = statusCode)
end.
end.

export. class. NotFoundError extends HttpError do.
constructor. message='Resource not found' do.
(super 404 message)
end.
end.

export. class. BadRequestError extends HttpError do.
constructor. message='Bad request' do.
(super 400 message)
end.
end.

export. fn. errorHandler err,req,res,next do.
if. (err instanceof HttpError) do.
((res.status err.statusCode).json O(error:err.message;statusCode:err.statusCode))
else.
((res.status 500).json O(error:'Internal Server Error';statusCode:500))
end.
end.