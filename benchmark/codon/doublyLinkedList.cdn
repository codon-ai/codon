class. DoublyNode do.
constructor. value do.
(this.value = value)
(this.prev = '')
(this.next = '')
end.
end.

export. class. DoublyLinkedList do.
constructor.  do.
(this.head = '')
(this.tail = '')
(this.size = 0)
end.
method. push value do.
node =: (new DoublyNode value)
if. (! this.tail) do.
(this.head = node)
(this.tail = node)
else.
(this.tail.next = node)
(node.prev = this.tail)
(this.tail = node)
end.
(this.size++)
end.
method. unshift value do.
node =: (new DoublyNode value)
if. (! this.head) do.
(this.head = node)
(this.tail = node)
else.
(node.next = this.head)
(this.head.prev = node)
(this.head = node)
end.
(this.size++)
end.
method. pop  do.
if. (! this.tail) do.
return. undefined
end.
value =: this.tail.value
if. (this.head === this.tail) do.
(this.head = '')
(this.tail = '')
else.
(this.tail = this.tail.prev)
(this.tail.next = '')
end.
(this.size--)
return. value
end.
method. shift  do.
if. (! this.head) do.
return. undefined
end.
value =: this.head.value
if. (this.head === this.tail) do.
(this.head = '')
(this.tail = '')
else.
(this.head = this.head.next)
(this.head.prev = '')
end.
(this.size--)
return. value
end.
method. toArray  do.
res =: (0$0)
cur =: this.head
while. cur do.
(res.push cur.value)
(cur = cur.next)
end.
return. res
end.
method. toArrayReverse  do.
res =: (0$0)
cur =: this.tail
while. cur do.
(res.push cur.value)
(cur = cur.prev)
end.
return. res
end.
end.