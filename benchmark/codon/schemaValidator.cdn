export. fn. validate schema,data do.
errors =: []
for_of. [field,rule] : (Object.entries schema) do.
val =: data.[field]
if. (rule.required && ((val === undefined) || (val === ''))) do.
(errors.push `Field "${field}" is required`)
continue.
end.
if. ((val !== undefined) && (val !== '')) do.
if. ((typeof val) !== rule.type) do.
(errors.push `Field "${field}" must be of type ${rule.type}`)
elseif. (rule.type === 'number') do.
if. ((rule.min !== undefined) && (val < rule.min)) do.
(errors.push `Field "${field}" must be at least ${rule.min}`)
end.
if. ((rule.max !== undefined) && (val > rule.max)) do.
(errors.push `Field "${field}" must be at most ${rule.max}`)
end.
elseif. (rule.type === 'string') do.
if. ((rule.min !== undefined) && (val.length < rule.min)) do.
(errors.push `Field "${field}" length must be at least ${rule.min}`)
end.
if. ((rule.max !== undefined) && (val.length > rule.max)) do.
(errors.push `Field "${field}" length must be at most ${rule.max}`)
end.
end.
end.
end.
return. O(isValid:(errors.length === 0);errors)
end.
