export. async_fn. retry fn,options do.
factor =: ((options.backoffFactor !== undefined) ? options.backoffFactor : 2)
attempt =: 0
while. true do.
try. do.
return. (@ fn())
catch. err do.
if. (attempt >= options.maxRetries) do.
throw. err
end.
delay =: (options.baseDelayMs * (Math.pow factor attempt))
(attempt++)
@ (new Promise {{res => (setTimeout res delay)}})
end.
end.
end.