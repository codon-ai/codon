import. React,{useState,useRef} from 'react'

export. fn. TodoList do.
[todos,setTodos] =: (useState (,O(id:1;text:'Buy milk';completed:false)))
[text,setText] =: (useState '')
[filter,setFilter] =: (useState 'all')
nextId =: (useRef 2)
addTodo =: {{e => do.
e.preventDefault()
if. (! text.trim()) do.
return.
end.
(setTodos (...todos;O(id:(nextId.current++);text:text.trim();completed:false)))
(setText '')
}}
toggleTodo =: {{id => do.
(setTodos (todos.map {{todo => ((todo.id === id) ? O(...todo;completed:(! todo.completed)) : todo)}}))
}}
deleteTodo =: {{id => do.
(setTodos (todos.filter {{todo => (todo.id !== id)}}))
}}
filteredTodos =: (todos.filter {{todo => do.
if. (filter === 'active') do.
return. (! todo.completed)
end.
if. (filter === 'completed') do.
return. todo.completed
end.
return. true
}})
return. (<div>
      <h2>Todo List</h2>
      <form onSubmit={addTodo}>
        <input value={text} onChange={e => setText(e.target.value)} placeholder="New todo..." />
        <button type="submit">Add</button>
      </form>
      <div>
        <button onClick={() => setFilter("all")}>All</button>
        <button onClick={() => setFilter("active")}>Active</button>
        <button onClick={() => setFilter("completed")}>Completed</button>
      </div>
      <ul>
        {filteredTodos.map(todo => <li key={todo.id}>
            <input type="checkbox" checked={todo.completed} onChange={() => toggleTodo(todo.id)} />
            <span>{todo.text}</span>
            <button onClick={() => deleteTodo(todo.id)}>Delete</button>
          </li>)}
      </ul>
    </div>)
end.