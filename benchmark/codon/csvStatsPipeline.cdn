export. fn. parseCSV raw do.
lines =: ((raw.trim()).split "\n")
[,...rows] =: lines
return. (((rows.map {{line => ((line.split ',').map {{cell => cell.trim()}})}}).filter {{[item,category,qty,price] => (((item && category) && (! (isNaN (Number qty)))) && (! (isNaN (Number price))))}}).map {{[item,category,qty,price] => O(item;category;quantity:(Number qty);price:(Number price))}})
end.

export. fn. aggregateByCategory records do.
summary =: O''
for_of. {category,quantity,price} : records do.
prev =: (summary.[category] ?? O(totalRevenue:0;totalQuantity:0;avgPrice:0))
totalRevenue =: (prev.totalRevenue + (quantity * price))
totalQuantity =: (prev.totalQuantity + quantity)
(summary.[category] = O(totalRevenue;totalQuantity;avgPrice:((Math.round ((totalRevenue / totalQuantity) * 100)) / 100)))
end.
return. summary
end.

mockCSV =: `
item,category,quantity,price
Apples,Produce,10,1.5
Oranges,Produce,5,2.0
Laptop,Electronics,1,999.0
Mouse,Electronics,2,25.5
`

(console.log (aggregateByCategory (parseCSV mockCSV)))