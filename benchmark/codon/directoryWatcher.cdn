import. fs from 'node:fs'

export. class. DirectoryWatcher do.
constructor.  do.
(this.watcher = '')
(this.timers = (new Map))
end.
method. watch dirPath,debounceMs,callback do.
(this.watcher = (fs.watch dirPath {{eventType,filename => do.
if. (! filename) do.
return.
end.
if. (this.timers.has filename) do.
(clearTimeout (this.timers.get filename))
end.
timer =: (setTimeout {{ => do.
(this.timers.delete filename)
(callback eventType filename)
}} debounceMs)
(this.timers.set filename timer)
}}))
end.
method. close  do.
for_of. timer : this.timers.values() do.
(clearTimeout timer)
end.
this.timers.clear()
if. this.watcher do.
this.watcher.close()
(this.watcher = '')
end.
end.
end.