import. React,{useState} from 'react'

export. fn. SearchAutocomplete {items,onSelect} do.
[query,setQuery] =: (useState '')
[isOpen,setIsOpen] =: (useState false)
filtered =: ((query.trim() === '') ? (0$0) : (items.filter {{item => ((item.toLowerCase()).includes query.toLowerCase())}}))
return. (<div>
      <input value={query} onChange={e => {
    setQuery(e.target.value);
    setIsOpen(true);
  }} placeholder="Search..." />
      {isOpen && filtered.length > 0 && <ul>
          {filtered.map(item => <li key={item} onClick={() => {
      onSelect(item);
      setQuery(item);
      setIsOpen(false);
    }}>
              {item}
            </li>)}
        </ul>}
    </div>)
end.