export. fn. knapsack weights,values,capacity do.
n =: weights.length
dp =: (Array.from O(length:(n + 1)) {{ => ((new Array (capacity + 1)).fill 0)}})
for. i =: 1 ; (i <= n) ; (i++) do.
for. w =: 0 ; (w <= capacity) ; (w++) do.
if. (weights.[(i - 1)] <= w) do.
(dp.[i].[w] = (Math.max dp.[(i - 1)].[w] (values.[(i - 1)] + dp.[(i - 1)].[(w - weights.[(i - 1)])])))
else.
(dp.[i].[w] = dp.[(i - 1)].[w])
end.
end.
end.
selectedIndices =: (0$0)
w =: capacity
for. i =: n ; (i > 0) ; (i--) do.
if. (dp.[i].[w] !== dp.[(i - 1)].[w]) do.
(selectedIndices.push (i - 1))
(w -= weights.[(i - 1)])
end.
end.
return. O(maxValue:dp.[n].[capacity];selectedIndices:selectedIndices.reverse())
end.