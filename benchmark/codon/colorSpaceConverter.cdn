export. fn. hexToRgb hex do.
clean =: ((hex.startsWith '#') ? (hex.slice 1) : hex)
if. (! (/^[0-9a-fA-F]{6}$/.test clean)) do.
throw. (new Error 'Invalid hex color')
end.
return. O(r:(parseInt (clean.slice 0 2) 16);g:(parseInt (clean.slice 2 4) 16);b:(parseInt (clean.slice 4 6) 16))
end.

export. fn. rgbToHex r,g,b do.
clamp =: {{x => (Math.max 0 (Math.min 255 (Math.round x)))}}
toHex =: {{x => (((clamp x).toString 16).padStart 2 '0').toUpperCase()}}
return. `#${(toHex r)}${(toHex g)}${(toHex b)}`
end.

export. fn. rgbToHsl r,g,b do.
rn =: (r / 255)
gn =: (g / 255)
bn =: (b / 255)
max =: (Math.max rn gn bn)
min =: (Math.min rn gn bn)
d =: (max - min)
h =: 0
s =: 0
l =: ((max + min) / 2)
if. (d !== 0) do.
(s = ((l > 0.5) ? (d / ((2 - max) - min)) : (d / (max + min))))
if. (max === rn) do.
(h = (((gn - bn) / d) + ((gn < bn) ? 6 : 0)))
elseif. (max === gn) do.
(h = (((bn - rn) / d) + 2))
else.
(h = (((rn - gn) / d) + 4))
end.
(h /= 6)
end.
return. O(h:(Math.round (h * 360));s:(Math.round (s * 100));l:(Math.round (l * 100)))
end.