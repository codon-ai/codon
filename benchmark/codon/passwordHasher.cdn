import. crypto from 'node:crypto'

export. async_fn. hashPassword password do.
salt =: (crypto.randomBytes 16)
derivedKey =: @ (new Promise {{resolve,reject => do.
(crypto.scrypt password salt 64 {{err,key => do.
if. err do.
(reject err)
else.
(resolve key)
end.
}})
}})
return. `${(salt.toString 'hex')}:${(derivedKey.toString 'hex')}`
end.

export. async_fn. verifyPassword password,storedHash do.
[saltHex,hashHex] =: (storedHash.split ':')
salt =: (Buffer.from saltHex 'hex')
storedKey =: (Buffer.from hashHex 'hex')
derivedKey =: @ (new Promise {{resolve,reject => do.
(crypto.scrypt password salt 64 {{err,key => do.
if. err do.
(reject err)
else.
(resolve key)
end.
}})
}})
return. (crypto.timingSafeEqual storedKey derivedKey)
end.