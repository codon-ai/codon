class. TrieNode do.
constructor.  do.
(this.children = (new Map))
(this.isEndOfWord = false)
end.
end.

export. class. Trie do.
constructor.  do.
(this.root = (new TrieNode))
end.
method. insert word do.
cur =: this.root
for_of. char : word do.
if. (! (cur.children.has char)) do.
(cur.children.set char (new TrieNode))
end.
(cur = (cur.children.get char))
end.
(cur.isEndOfWord = true)
end.
method. search word do.
cur =: this.root
for_of. char : word do.
if. (! (cur.children.has char)) do.
return. false
end.
(cur = (cur.children.get char))
end.
return. ((cur !== undefined) && (cur.isEndOfWord === true))
end.
method. startsWith prefix do.
cur =: this.root
for_of. char : prefix do.
if. (! (cur.children.has char)) do.
return. false
end.
(cur = (cur.children.get char))
end.
return. (cur !== undefined)
end.
end.

trie =: (new Trie)

(trie.insert 'apple')

(trie.insert 'app')