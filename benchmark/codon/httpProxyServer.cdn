import. http from 'node:http'

export. fn. createProxyServer targetHost,targetPort do.
return. (http.createServer {{req,res => do.
options =: O(hostname:targetHost;port:targetPort;path:req.url;method:req.method;headers:O(...req.headers;host:`${targetHost}:${targetPort}`))
proxyReq =: (http.request options {{proxyRes => do.
(res.writeHead (proxyRes.statusCode || 200) proxyRes.headers)
(proxyRes.pipe res)
}})
(proxyReq.on 'error' {{ => do.
(res.writeHead 502 O('Content-Type':'application/json'))
(res.end (JSON.stringify O(error:'Bad Gateway')))
}})
(req.pipe proxyReq)
}})
end.