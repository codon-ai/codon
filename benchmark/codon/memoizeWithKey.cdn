export. fn. memoize fn,keyResolver do.
cache =: (new Map)
resolver =: (keyResolver || {{...args => (JSON.stringify args)}})
fn. memoized ...args do.
key =: (resolver ...args)
if. (cache.has key) do.
return. (cache.get key)
end.
result =: (fn ...args)
(cache.set key result)
return. result
end.
(memoized.cache = cache)
(memoized.clear = {{ => cache.clear()}})
return. memoized
end.