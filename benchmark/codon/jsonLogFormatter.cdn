export. class. JsonLogger do.
constructor. serviceName,minLevel='INFO' do.
(this.serviceName = serviceName)
(this.minLevel = minLevel)
(this.levels = O(DEBUG:0;INFO:1;WARN:2;ERROR:3))
end.
method. log level,message,context do.
if. (this.levels.[level] >= this.levels.[this.minLevel]) do.
entry =: O(service:this.serviceName;timestamp:(new Date).toISOString();level;message;...(context ? O(context) : O''))
line =: ((JSON.stringify entry) + "\n")
if. (level === 'ERROR') do.
(process.stderr.write line)
else.
(process.stdout.write line)
end.
end.
end.
method. debug msg,ctx do.
(this.log 'DEBUG' msg ctx)
end.
method. info msg,ctx do.
(this.log 'INFO' msg ctx)
end.
method. warn msg,ctx do.
(this.log 'WARN' msg ctx)
end.
method. error msg,ctx do.
(this.log 'ERROR' msg ctx)
end.
end.