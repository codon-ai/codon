export. fn. unflattenObject flat do.
result =: O''
for_of. [fullKey,val] : (Object.entries flat) do.
keys =: (fullKey.split '.')
cur =: result
for. i =: 0 ; (i < (keys.length - 1)) ; (i++) do.
k =: keys.[i]
if. ((! cur.[k]) || ((typeof cur.[k]) !== 'object')) do.
(cur.[k] = O'')
end.
(cur = cur.[k])
end.
(cur.[keys.[(keys.length - 1)]] = val)
end.
return. result
end.