import. React,{useState} from 'react'

export. fn. Tabs {tabs} do.
[activeTabId,setActiveTabId] =: (useState (tabs.[0]?.id || ''))
currentTab =: (tabs.find {{t => (t.id === activeTabId)}})
return. (<div>
      <nav>
        {tabs.map(tab => <button key={tab.id} onClick={() => setActiveTabId(tab.id)}>
            {tab.label}
          </button>)}
      </nav>
      <div role="tabpanel">{currentTab?.content}</div>
    </div>)
end.