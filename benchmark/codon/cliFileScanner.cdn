NB. i|D:fs:node%3Afs/promises|D:path:node%3Apath

NB. export
{{ NB. async FD|scanDir|dir,extension
entries =: (@ (fs.readdir dir O('withFileTypes';true)))
results =: (0$0)
for_of. entry : entries do.
fullPath =: (path.join dir entry.name)
if. entry.isDirectory() do.
(results.push '...';(@ (scanDir fullPath extension)))
elseif. (entry.isFile() && (entry.name.endsWith extension)) do.
stats =: (@ (fs.stat fullPath))
(results.push O('path';fullPath;'size';stats.size))
end.
end.
return. results
}}

{{ NB. async FD|main|
targetDir =: (process.argv.[2] || '.')
ext =: (process.argv.[3] || '.ts')
files =: (@ (scanDir targetDir ext))
totalSize =: (files.reduce ({{ NB. pE|acc,f
(acc + f.size)
}}) 0)
(console.log `Found ${files.length} files (${totalSize} bytes):`)
for_of. file : files do.
(console.log ` - ${file.path} (${file.size} bytes)`)
end.
}}

if. (process.argv.[1]?.endsWith?. 'cliFileScanner.js') do.
((main()).catch console.error)
end.