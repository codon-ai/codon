export. fn. markdownToHtml md do.
lines =: (md.split "\n")
processed =: (0$0)
for_of. line : lines do.
trimmed =: line.trim()
if. (! trimmed) do.
continue.
end.
parsed =: trimmed
isHeader =: false
if. (parsed.startsWith '### ') do.
(parsed = (('<h3>' + (parsed.slice 4)) + '</h3>'))
(isHeader = true)
elseif. (parsed.startsWith '## ') do.
(parsed = (('<h2>' + (parsed.slice 3)) + '</h2>'))
(isHeader = true)
elseif. (parsed.startsWith '# ') do.
(parsed = (('<h1>' + (parsed.slice 2)) + '</h1>'))
(isHeader = true)
end.
(parsed = (parsed.replace (new RegExp '\*\*(.*?)\*\*' 'g') '<strong>$1</strong>'))
(parsed = (parsed.replace (new RegExp '\*(.*?)\*' 'g') '<em>$1</em>'))
(parsed = (parsed.replace (new RegExp '`([^`]+)`' 'g') '<code>$1</code>'))
(parsed = (parsed.replace (new RegExp '\[([^\]]+)\]\(([^\)]+)\)' 'g') '<a href="$2">$1</a>'))
if. ((! isHeader) && (! (parsed.startsWith '<h'))) do.
(parsed = (('<p>' + parsed) + '</p>'))
end.
(processed.push parsed)
end.
return. (processed.join "\n")
end.