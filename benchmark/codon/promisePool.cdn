export. async_fn. promisePool items,concurrency,worker do.
results =: (new Array items.length)
nextIndex =: 0
async_fn. dispatch do.
while. (nextIndex < items.length) do.
i =: (nextIndex++)
(results.[i] = (@ (worker items.[i] i)))
end.
end.
runners =: (Array.from O(length:(Math.min concurrency items.length)) {{ => dispatch()}})
@ (Promise.all runners)
return. results
end.