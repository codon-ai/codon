export. fn. matrixAdd a,b do.
if. ((a.length !== b.length) || (a.[0].length !== b.[0].length)) do.
throw. (new Error 'Matrix dimension mismatch')
end.
return. (a.map {{row,i => (row.map {{val,j => (val + b.[i].[j])}})}})
end.

export. fn. matrixScalarMultiply m,scalar do.
return. (m.map {{row => (row.map {{val => (val * scalar)}})}})
end.

export. fn. matrixMultiply a,b do.
if. (a.[0].length !== b.length) do.
throw. (new Error 'Incompatible matrix dimensions for multiplication')
end.
rowsA =: a.length
colsA =: a.[0].length
colsB =: b.[0].length
result =: (Array.from O(length:rowsA) {{ => ((new Array colsB).fill 0)}})
for. i =: 0 ; (i < rowsA) ; (i++) do.
for. j =: 0 ; (j < colsB) ; (j++) do.
sum =: 0
for. k =: 0 ; (k < colsA) ; (k++) do.
(sum += (a.[i].[k] * b.[k].[j]))
end.
(result.[i].[j] = sum)
end.
end.
return. result
end.