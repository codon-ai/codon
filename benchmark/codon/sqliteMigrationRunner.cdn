import. Database from 'better-sqlite3'

export. class. MigrationRunner do.
constructor. db do.
(this.db = db)
(this.db.exec 'CREATE TABLE IF NOT EXISTS migrations (version INTEGER PRIMARY KEY, name TEXT, applied_at TEXT)')
end.
method. getAppliedVersions  do.
rows =: (this.db.prepare 'SELECT version FROM migrations ORDER BY version ASC').all()
return. (rows.map {{r => r.version}})
end.
method. apply migrations do.
sorted =: ((,...migrations).sort {{a,b => (a.version - b.version)}})
applied =: (new Set this.getAppliedVersions())
newlyApplied =: (0$0)
insertStmt =: (this.db.prepare 'INSERT INTO migrations (version, name, applied_at) VALUES (?, ?, ?)')
tx =: (this.db.transaction {{ => do.
for_of. m : sorted do.
if. (! (applied.has m.version)) do.
(this.db.exec m.sql)
(insertStmt.run m.version m.name (new Date).toISOString())
(newlyApplied.push m.version)
end.
end.
}})
tx()
return. newlyApplied
end.
end.