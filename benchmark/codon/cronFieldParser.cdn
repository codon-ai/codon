fn. expandField field,min,max do.
values =: (new Set)
parts =: (field.split ',')
for_of. part : parts do.
if. (part === '*') do.
for. i =: min ; (i <= max) ; (i++) do.
(values.add i)
end.
elseif. (part.startsWith '*/') do.
step =: (parseInt (part.slice 2) 10)
for. i =: min ; (i <= max) ; (i += step) do.
(values.add i)
end.
elseif. (part.includes '-') do.
[rangePart,stepPart] =: (part.split '/')
[start,end] =: ((rangePart.split '-').map Number)
step =: (stepPart ? (parseInt stepPart 10) : 1)
for. i =: start ; (i <= end) ; (i += step) do.
(values.add i)
end.
else.
(values.add (parseInt part 10))
end.
end.
return. ((Array.from values).sort {{a,b => (a - b)}})
end.

export. fn. parseCron expr do.
parts =: ((expr.trim()).split /\s+/)
if. (parts.length !== 5) do.
throw. (new Error 'Invalid cron expression')
end.
return. O(minutes:(expandField parts.[0] 0 59);hours:(expandField parts.[1] 0 23);daysOfMonth:(expandField parts.[2] 1 31);months:(expandField parts.[3] 1 12);daysOfWeek:(expandField parts.[4] 0 6))
end.