NB. i|D:express:express

app =: express()

counter =: 0

(app.get '/' {{fn _,res => do.
(res.json O(counter))
}})

(app.get '/increment' {{fn _,res => do.
(counter++)
(res.json O(counter))
}})

(app.get '/decrement' {{fn _,res => do.
(counter--)
(res.json O(counter))
}})

(app.get '/reset' {{fn _,res => do.
(counter = 0)
(res.json O(counter))
}})

(app.listen 8080)