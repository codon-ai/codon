export. fn. corsMiddleware options=O'' do.
return. {{fn req,res,next => do.
(res.setHeader 'Access-Control-Allow-Origin' (options.origin || '*'))
if. options.allowCredentials do.
(res.setHeader 'Access-Control-Allow-Credentials' 'true')
end.
if. options.methods do.
(res.setHeader 'Access-Control-Allow-Methods' (options.methods.join ', '))
end.
if. options.allowedHeaders do.
(res.setHeader 'Access-Control-Allow-Headers' (options.allowedHeaders.join ', '))
end.
if. options.maxAge do.
(res.setHeader 'Access-Control-Max-Age' (String options.maxAge))
end.
if. (req.method === 'OPTIONS') do.
(res.statusCode = 204)
res.end()
else.
next()
end.
}}
end.