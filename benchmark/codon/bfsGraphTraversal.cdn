export. fn. bfs graph,startNode do.
queue =: (,startNode)
visited =: (new Set (,startNode))
visitedOrder =: (0$0)
while. (queue.length > 0) do.
curr =: queue.shift()
(visitedOrder.push curr)
for_of. neighbor : (graph.[curr] || (0$0)) do.
if. (! (visited.has neighbor)) do.
(visited.add neighbor)
(queue.push neighbor)
end.
end.
end.
return. visitedOrder
end.