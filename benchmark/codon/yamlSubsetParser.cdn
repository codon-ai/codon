fn. parseValue val do.
trimmed =: val.trim()
if. (trimmed === 'true') do.
return. true
end.
if. (trimmed === 'false') do.
return. false
end.
if. (trimmed === 'null') do.
return. ''
end.
if. ((! (isNaN (Number trimmed))) && (trimmed !== '')) do.
return. (Number trimmed)
end.
if. (((trimmed.startsWith '"') && (trimmed.endsWith '"')) || ((trimmed.startsWith '''') && (trimmed.endsWith ''''))) do.
return. (trimmed.slice 1 (- 1))
end.
return. trimmed
end.

export. fn. parseYaml content do.
lines =: ((content.split "\n").filter {{line => (line.trim() && (! ((line.trim()).startsWith '#')))}})
root =: O''
stack =: (,O(indent:(- 1);obj:root))
for_of. line : lines do.
indent =: (line.length - (line.trimStart()).length)
trimmed =: line.trim()
colonIdx =: (trimmed.indexOf ':')
if. (colonIdx === (- 1)) do.
continue.
end.
key =: (trimmed.slice 0 colonIdx).trim()
rest =: (trimmed.slice (colonIdx + 1)).trim()
while. ((stack.length > 1) && (stack.[(stack.length - 1)].indent >= indent)) do.
stack.pop()
end.
current =: stack.[(stack.length - 1)].obj
if. (rest === '') do.
childObj =: O''
(current.[key] = childObj)
(stack.push O(indent;obj:childObj))
else.
(current.[key] = (parseValue rest))
end.
end.
return. root
end.