export. fn. parseEnv content do.
result =: O''
lines =: (content.split "\n")
for_of. rawLine : lines do.
line =: rawLine.trim()
if. ((! line) || (line.startsWith '#')) do.
continue.
end.
eqIndex =: (line.indexOf '=')
if. (eqIndex === (- 1)) do.
continue.
end.
key =: (line.slice 0 eqIndex).trim()
value =: (line.slice (eqIndex + 1)).trim()
if. (((value.startsWith '"') && (value.endsWith '"')) || ((value.startsWith '''') && (value.endsWith ''''))) do.
(value = (value.slice 1 (- 1)))
end.
(value = ((((value.split '\n').join "\n").split '\t').join "\t"))
(result.[key] = value)
end.
return. result
end.