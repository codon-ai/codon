export. fn. createStore initialState do.
state =: O(...initialState)
listeners =: (new Set)
return. O(getState:{{ => state}};setState:{{partial => do.
updates =: (((typeof partial) === 'function') ? (partial state) : partial)
(state = O(...state;...updates))
for_of. listener : listeners do.
(listener state)
end.
}};subscribe:{{listener => do.
(listeners.add listener)
return. {{ => (listeners.delete listener)}}
}})
end.