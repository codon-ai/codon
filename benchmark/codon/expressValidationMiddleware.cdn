export. fn. validateBody schema do.
return. {{fn req,res,next => do.
body =: (req.body || O'')
errors =: (0$0)
for_of. [field,rule] : (Object.entries schema) do.
val =: body.[field]
if. (rule.required && ((val === undefined) || (val === ''))) do.
(errors.push `Field "${field}" is required`)
continue.
end.
if. ((val !== undefined) && (val !== '')) do.
if. (rule.type === 'array') do.
if. (! (Array.isArray val)) do.
(errors.push `Field "${field}" must be of type array`)
end.
elseif. ((typeof val) !== rule.type) do.
(errors.push `Field "${field}" must be of type ${rule.type}`)
end.
end.
end.
if. (errors.length > 0) do.
return. ((res.status 400).json O(errors))
end.
next()
}}
end.