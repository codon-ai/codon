export. fn. throttle fn,limitMs do.
inThrottle =: false
lastArgs =: ''
return. {{fn ...args => do.
if. (! inThrottle) do.
(fn ...args)
(inThrottle = true)
(setTimeout {{ => do.
if. lastArgs do.
(fn ...lastArgs)
(lastArgs = '')
(setTimeout {{ => do.
(inThrottle = false)
}} limitMs)
else.
(inThrottle = false)
end.
}} limitMs)
else.
(lastArgs = args)
end.
}}
end.