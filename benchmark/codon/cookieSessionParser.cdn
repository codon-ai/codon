export. fn. parseCookies header do.
if. (! header) do.
return. O''
end.
cookies =: O''
pairs =: (header.split ';')
for_of. pair : pairs do.
trimmed =: pair.trim()
eqIdx =: (trimmed.indexOf '=')
if. (eqIdx !== (- 1)) do.
key =: (decodeURIComponent (trimmed.slice 0 eqIdx).trim())
val =: (decodeURIComponent (trimmed.slice (eqIdx + 1)).trim())
(cookies.[key] = val)
end.
end.
return. cookies
end.

export. fn. serializeCookie name,value,options=O'' do.
cookie =: `${(encodeURIComponent name)}=${(encodeURIComponent value)}`
if. (options.maxAge !== undefined) do.
(cookie += `; Max-Age=${options.maxAge}`)
end.
(cookie += `; Path=${(options.path || '/')}`)
if. options.httpOnly do.
(cookie += '; HttpOnly')
end.
if. options.secure do.
(cookie += '; Secure')
end.
if. options.sameSite do.
(cookie += `; SameSite=${options.sameSite}`)
end.
return. cookie
end.