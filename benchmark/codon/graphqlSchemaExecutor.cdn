export. class. MiniGraphQL do.
constructor.  do.
(this.resolvers = (new Map))
end.
method. register field,resolver do.
(this.resolvers.set field resolver)
end.
async_method. execute query do.
trimmed =: query.trim()
if. ((! (trimmed.startsWith '{')) || (! (trimmed.endsWith '}'))) do.
return. O(data:O'';errors:(,'Invalid GraphQL query format'))
end.
inner =: (trimmed.slice 1 (- 1)).trim()
parenIdx =: (inner.indexOf '(')
fieldName =: ''
argsStr =: ''
if. (parenIdx !== (- 1)) do.
if. (! (inner.endsWith ')')) do.
return. O(data:O'';errors:(,'Invalid GraphQL query format'))
end.
(fieldName = (inner.slice 0 parenIdx).trim())
(argsStr = (inner.slice (parenIdx + 1) (- 1)).trim())
else.
(fieldName = inner.trim())
end.
args =: O''
if. argsStr do.
pairs =: (argsStr.split ',')
for_of. pair : pairs do.
[k,v] =: ((pair.split ':').map {{s => s.trim()}})
if. (k && (v !== undefined)) do.
if. ((v.startsWith '"') && (v.endsWith '"')) do.
(args.[k] = (v.slice 1 (- 1)))
else.
(args.[k] = (Number v))
end.
end.
end.
end.
if. (! (this.resolvers.has fieldName)) do.
return. O(data:O'';errors:(,`Field "${fieldName}" not found`))
end.
resolver =: (this.resolvers.get fieldName)
result =: @ (resolver args)
return. O(data:O(fieldName:result))
end.
end.